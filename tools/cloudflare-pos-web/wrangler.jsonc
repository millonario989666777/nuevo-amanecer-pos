{
  "$schema": "../cloudflare-lab/node_modules/wrangler/config-schema.json",
  "name": "nuevo-amanecer-pos-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/app",
      "/app/",
      "/health",
      "/auth/*",
      "/read/*",
      "/commands/*",
      "/imports/*",
      "/sync/operations*",
      "/settings"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "HOSTED_ENVIRONMENT": "production",
    "CANON_API_ORIGIN": "https://nuevo-amanecer-pos-prod.nuevo-amanecer-pos.workers.dev"
  },
  "services": [
    {
      "binding": "CANON_BACKEND",
      "service": "nuevo-amanecer-pos-prod"
    }
  ]
}
